# Copy to .env for local development and for the CLI scripts.
# On Vercel or Render, set these in the dashboard instead.

# Your Bluesky handle: the admin account, which owns the feeds in feeds/.
BSKY_IDENTIFIER=you.bsky.social

# Optional. Other people who may sign in with their own Bluesky account and make
# their own feeds. Handles separated by commas or spaces.
# ALLOWED_ACCOUNTS=friend.bsky.social, other.bsky.social

# Turns on sign-in and the feed editor. Use file:local.db for local development,
# or your Turso database in production:
#   TURSO_DATABASE_URL=libsql://<name>-<org>.turso.io
#   TURSO_AUTH_TOKEN=...
TURSO_DATABASE_URL=file:local.db

# Optional. In production the app generates its OAuth signing key and keeps it in
# the database. Set one from `npm run oauth-key` to manage it yourself.
# OAUTH_PRIVATE_KEY={"kty":"EC",...}

# Needed for `npm run publish-feeds`, and for search feeds if you don't use the
# dashboard. Create one at https://bsky.app/settings/app-passwords
# BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Public hostname of your deployment (no https://), for publish-feeds. Leave unset
# for local development; Vercel and Render are detected automatically.
# FEEDGEN_HOSTNAME=my-feeds.vercel.app

# Needed only if BSKY_IDENTIFIER is an email address. publish-feeds prints it.
# FEEDGEN_PUBLISHER_DID=did:plc:...

# Enables the playground without signing in. Any long random string.
# ADMIN_TOKEN=

# Optional tuning.
# CACHE_SECONDS=60
# STALE_SECONDS=600
# PORT=3000
