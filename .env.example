# Copy to .env for local development and for `npm run publish-feeds`.
# On Vercel or Render, set these in the dashboard instead.

# Public hostname of your deployment (no https://). On Vercel and Render this is
# detected automatically, but publish-feeds needs it set locally.
FEEDGEN_HOSTNAME=my-feeds.vercel.app

# The account that owns the feeds. Use your handle, not your email, so the
# service can work out your DID. Create an app password (not your real
# password) at https://bsky.app/settings/app-passwords
BSKY_IDENTIFIER=you.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Needed only if BSKY_IDENTIFIER is an email address. publish-feeds prints it.
# FEEDGEN_PUBLISHER_DID=did:plc:...

# Protects the /playground page. Any long random string.
ADMIN_TOKEN=change-me

# Optional tuning.
# CACHE_SECONDS=60
# STALE_SECONDS=600
# BSKY_SERVICE=https://bsky.social
# PORT=3000
